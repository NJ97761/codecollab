PORT=3001
# Path to Firebase service account key JSON file
# Download from: Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# ─── [NEW ADDITION - Offensive Language Filter] ─────────────────────────────
# ML-powered offensive language detection. Set ONE or more to enable AI moderation.
# Server tries in order: Local ML → HuggingFace → Perspective.
# If none set, only the existing leo-profanity word filter is used.

# Option 1: Local Python ML microservice
# ML_SERVICE_URL=http://localhost:5001

# Option 2: HuggingFace Inference API (free tier)
# HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx

# Option 3: Google Perspective API
# PERSPECTIVE_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXX
